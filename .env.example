# Copy to .env and adjust. Nothing here requires a paid API key.

# Local Ollama server used for chat (qwen3.5:9b, gemma4:e4b) and embeddings
# (nomic-embed-text). The gateway rewrites http://localhost:11434 in
# configs/gateway.yaml to this value, e.g. http://host.docker.internal:11434
# when the gateway runs in a container.
LLMGW_OLLAMA_URL=http://localhost:11434

# Gateway configuration file: configs/gateway.yaml (Ollama, default) or
# configs/gateway.mock.yaml (bundled mock upstream, no model downloads).
LLMGW_CONFIG=configs/gateway.yaml

# Dev-only JWT signing secret for /v1/auth/token tokens.
LLMGW_JWT_SECRET=dev-insecure-change-me

# Optional: only if you point providers at paid APIs instead of Ollama.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
